<?xml version="1.0"?>
<!-- Local standalone invocation; numerical parameters come only from official CS66 YAML. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="elite_cs66">
  <xacro:include filename="$(find elite_robots_description)/urdf/cs_macro.xacro"/>
  <link name="world"/>
  <xacro:cs_robot name="elite_cs66" tf_prefix="" parent="world"
    joint_limits_parameters_file="$(find elite_robots_description)/config/cs66/joint_limits.yaml"
    kinematics_parameters_file="$(find elite_robots_description)/config/cs66/default_kinematics.yaml"
    physical_parameters_file="$(find elite_robots_description)/config/cs66/physical_parameters.yaml"
    visual_parameters_file="$(find elite_robots_description)/config/cs66/visual_parameters.yaml"
    generate_ros2_control_tag="false" safety_limits="false"
    sim_gazebo="false" sim_ignition="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:cs_robot>
</robot>
